# Copie este arquivo para .env.local e preencha com os valores reais.
# .env.local é ignorado pelo git.

# ─────────────────────────────────────────────────────────
# Google Reviews (depoimentos em tempo real)
# ─────────────────────────────────────────────────────────
# 1. Habilite a "Places API (New)" no Google Cloud Console:
#    https://console.cloud.google.com/apis/library/places.googleapis.com
# 2. Crie uma API key e RESTRINJA por:
#    - Application: HTTP referrers (não funciona) — use IP/None pois é server-side
#    - API: somente "Places API (New)"
# 3. Encontre o Place ID da clínica:
#    https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# ─────────────────────────────────────────────────────────
# WhatsApp (Phase 3 — não usado ainda em runtime)
# ─────────────────────────────────────────────────────────
# E.164 sem "+", ex: 5562999999999
NEXT_PUBLIC_WHATSAPP_PHONE=
